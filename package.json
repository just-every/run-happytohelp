{
  "name": "happytohelp",
  "version": "0.4.12",
  "description": "Open-source customer support workspace: chat widget, team inbox, AI-assisted replies and help centers on Cloudflare Workers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/just-every/run-happytohelp"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "build": "rer build",
    "build:assets": "node scripts/build-local-agent.cjs && pnpm run build:widget",
    "dev": "rer dev",
    "preview": "rer preview",
    "typecheck": "node scripts/generate-routes.mjs && tsc --noEmit",
    "verify": "rer verify",
    "setup": "rer setup",
    "deploy": "rer deploy",
    "build:widget": "node scripts/build-widget.mjs",
    "source:inspect": "node scripts/edition-authoring/cli.mjs inspect",
    "source:check": "node scripts/edition-authoring/cli.mjs check > /dev/null",
    "source:lock": "node scripts/edition-authoring/cli.mjs lock > /dev/null",
    "source:release": "node scripts/edition-authoring/cli.mjs release",
    "migrations:prepare": "node scripts/migrations.mjs",
    "source:verify-base-origin": "node scripts/edition-authoring/cli.mjs verify-base",
    "build:app": "node scripts/build.mjs",
    "reset": "rer reset",
    "export": "rer export",
    "import": "rer import",
    "release": "rer release",
    "doctor": "rer doctor",
    "describe": "rer describe",
    "check": "rer check",
    "deps": "rer install",
    "rer": "rer",
    "test:routes": "node scripts/test-journeys.mjs routes",
    "test:browsers": "node scripts/test-journeys.mjs browsers",
    "test:nightly": "node scripts/test-journeys.mjs extended",
    "test:installer-nightly": "node scripts/installer/qualify.mjs",
    "test:legacy-export": "node --test --test-concurrency=1 tests/legacy-export.mjs",
    "test:live": "node --test --test-concurrency=1 tests/journeys/ai-live.mjs",
    "test:docs-browser": "node --test --test-concurrency=1 tests/journeys/first-run-browser.mjs",
    "verify:build": "rer check --profile first-party && pnpm run typecheck && pnpm run source:check && node scripts/contract-docs.mjs check && node scripts/edition-authoring/cli.mjs verify-base --offline",
    "verify:app": "pnpm run verify:build && pnpm run build && pnpm run test:routes && pnpm run test:browsers",
    "verify:release": "pnpm run build && node scripts/installer/qualify.mjs",
    "contract:write": "node scripts/contract-docs.mjs write",
    "contract:check": "node scripts/contract-docs.mjs check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.111.0",
    "@floating-ui/react": "^0.26.22",
    "@fortawesome/fontawesome-svg-core": "^6.7.1",
    "@fortawesome/free-solid-svg-icons": "^6.7.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@google/genai": "2.11.0",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "autosize": "^6.0.1",
    "bootstrap": "^5.3.3",
    "classnames": "^2.5.1",
    "css-color-names": "^1.0.1",
    "date-fns": "^2.30.0",
    "feather-icons": "4.29.2",
    "h2h-widget-external-links": "npm:remark-external-links@^9.0.1",
    "h2h-widget-gfm": "npm:remark-gfm@^4.0.0",
    "h2h-widget-markdown": "npm:react-markdown@^9.0.1",
    "highlight.js": "^10.7.3",
    "hono": "4.13.11",
    "html-to-text": "10.0.1",
    "i18n-iso-countries": "^6.3.0",
    "initials": "^3.1.1",
    "khroma": "^1.4.1",
    "moment": "^2.31.0",
    "moment-timezone": "^0.5.33",
    "object-merge-advanced": "^14.0.18",
    "openai": "6.46.0",
    "postal-mime": "4.0.8",
    "pretty-bytes": "^5.5.0",
    "prop-types": "^15.7.2",
    "react": "19.2.8",
    "react-bootstrap": "^2.10.6",
    "react-cool-onclickoutside": "^1.5.9",
    "react-dom": "19.2.8",
    "react-dropzone": "^14.3.5",
    "react-hook-form": "^7.45.2",
    "react-infinite-scroll-hook": "^4.0.1",
    "react-markdown": "^6.0.2",
    "react-scroll-to-bottom": "^4.0.0",
    "react-shadow": "^20.5.0",
    "react-textarea-autosize": "^8.3.2",
    "react-timeago": "^7.1.0",
    "remark-external-links": "^8.0.0",
    "remark-gfm": "^1.0.0",
    "turndown": "^7.2.0",
    "ua-parser-js": "1.0.41",
    "uqr": "0.1.2",
    "use-file-input": "^1.0.0",
    "use-window-focus": "^1.3.0",
    "uuid": "14.0.1",
    "ws": "8.21.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@runeditrun/rer": "0.2.77",
    "@tanstack/router-generator": "1.167.40",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "esbuild": "0.28.1",
    "mysql2": "3.24.6",
    "playwright": "1.63.0-alpha-2026-08-31",
    "sass": "^1.93.0",
    "typescript": "5.9.3",
    "vite": "8.2.4",
    "wrangler": "4.129.1"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.5",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "zod@<4.6.6": "4.6.6"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
