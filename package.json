{
  "name": "happytohelp",
  "version": "0.4.13",
  "description": "Open-source customer support workspace: chat widget, team inbox, AI-assisted replies and help centers on Cloudflare Workers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/just-every/run-happytohelp"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "build": "rer build",
    "build:assets": "node scripts/build-local-agent.cjs && pnpm run build:widget",
    "dev": "rer dev",
    "preview": "rer preview",
    "typecheck": "node scripts/generate-routes.mjs && tsc --noEmit",
    "verify": "rer verify",
    "setup": "rer setup",
    "deploy": "rer deploy",
    "build:widget": "node scripts/build-widget.mjs",
    "source:inspect": "node scripts/edition-authoring/cli.mjs inspect",
    "source:check": "node scripts/edition-authoring/cli.mjs check",
    "source:lock": "node scripts/edition-authoring/cli.mjs lock",
    "source:release": "node scripts/edition-authoring/cli.mjs release",
    "migrations:prepare": "node scripts/migrations.mjs",
    "source:verify-base-origin": "node scripts/edition-authoring/cli.mjs verify-base",
    "build:app": "node scripts/build.mjs",
    "verify:build": "rer check --profile first-party && pnpm run typecheck && pnpm run source:check && node scripts/contract-docs.mjs check && node scripts/edition-authoring/cli.mjs verify-base --offline",
    "verify:app": "pnpm run verify:build && pnpm run build && pnpm run test:routes && pnpm run test:browsers",
    "reset": "rer reset",
    "export": "rer export",
    "import": "rer import",
    "release": "rer release",
    "doctor": "rer doctor",
    "describe": "rer describe",
    "check": "rer check",
    "deps": "rer install",
    "rer": "rer",
    "verify:release": "pnpm run build && H2H_UPGRADE_RELEASES=0.4.1 node --test --test-concurrency=1 tests/journeys/upgrade-nightly.mjs",
    "test:routes": "node --test --test-concurrency=2 tests/journeys/ai.mjs tests/journeys/connections.mjs tests/journeys/connector.mjs tests/journeys/context.mjs tests/journeys/customers.mjs tests/journeys/delegation.mjs tests/journeys/delegation-computers.mjs tests/journeys/email.mjs tests/journeys/erasure.mjs tests/journeys/first-run.mjs tests/journeys/identity.mjs tests/journeys/inbox.mjs tests/journeys/knowledge.mjs tests/journeys/legacy.mjs tests/journeys/move-in-admission.mjs tests/journeys/move-in-custody.mjs tests/journeys/move-in-erasure.mjs tests/journeys/public.mjs tests/journeys/reports.mjs tests/journeys/restore.mjs tests/journeys/runtime.mjs tests/journeys/upgrade.mjs tests/journeys/widget.mjs",
    "test:browsers": "node --test --test-concurrency=2 tests/journeys/public-browser.mjs tests/journeys/identity-browser.mjs tests/journeys/inbox-browser.mjs tests/journeys/move-in-browser.mjs tests/journeys/delegation-browser.mjs tests/journeys/erasure-browser.mjs tests/journeys/workflows-browser.mjs",
    "test:scale": "node --test --test-concurrency=1 tests/journeys/move-in-capacity.mjs tests/reports/nightly.mjs",
    "test:installer-nightly": "node scripts/installer/qualify.mjs",
    "test:nightly": "pnpm run test:scale && pnpm run test:installer-nightly",
    "test:live": "node --test --test-concurrency=1 tests/journeys/ai-live.mjs",
    "test:legacy-export": "node --test tests/legacy-export.mjs",
    "contract:write": "node scripts/contract-docs.mjs write",
    "contract:check": "node scripts/contract-docs.mjs check",
    "test:identity": "node --test --test-concurrency=1 tests/journeys/identity.mjs",
    "test:erasure": "node --test --test-concurrency=1 tests/journeys/erasure.mjs",
    "test:widget": "node --test --test-concurrency=1 tests/journeys/widget.mjs",
    "test:inbox": "node --test --test-concurrency=1 tests/journeys/inbox.mjs tests/journeys/customers.mjs",
    "test:knowledge": "node --test --test-concurrency=1 tests/journeys/knowledge.mjs",
    "test:email": "node --test --test-concurrency=1 tests/journeys/email.mjs",
    "test:context": "node --test --test-concurrency=1 tests/journeys/context.mjs",
    "test:ai": "node --test --test-concurrency=1 tests/journeys/ai.mjs",
    "test:connections": "node --test --test-concurrency=1 tests/journeys/connections.mjs",
    "test:delegation": "node --test --test-concurrency=1 tests/journeys/delegation.mjs tests/journeys/delegation-computers.mjs tests/journeys/connector.mjs",
    "test:move-in": "node --test --test-concurrency=1 tests/journeys/move-in-admission.mjs tests/journeys/move-in-custody.mjs tests/journeys/move-in-erasure.mjs",
    "test:reports": "node --test --test-concurrency=1 tests/journeys/reports.mjs",
    "test:restore": "node --test --test-concurrency=1 tests/journeys/restore.mjs",
    "test:upgrade": "node --test --test-concurrency=1 tests/journeys/upgrade.mjs",
    "test:public": "node --test --test-concurrency=1 tests/journeys/public.mjs",
    "test:first-run": "node --test --test-concurrency=1 tests/journeys/first-run.mjs",
    "test:runtime": "node --test --test-concurrency=1 tests/journeys/runtime.mjs",
    "test:journey": "node --test --test-concurrency=1 tests/journeys/runtime.mjs",
    "test:modules": "pnpm run test:routes",
    "test:docs-browser": "node --test tests/journeys/public-browser.mjs",
    "test:docs-site": "node --test tests/journeys/public.mjs",
    "test:base-origin": "pnpm run source:verify-base-origin",
    "test:usage": "pnpm run test:ai"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.111.0",
    "@floating-ui/react": "^0.26.22",
    "@fortawesome/fontawesome-svg-core": "^6.7.1",
    "@fortawesome/free-solid-svg-icons": "^6.7.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@google/genai": "2.11.0",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "autosize": "^6.0.1",
    "bootstrap": "^5.3.3",
    "classnames": "^2.5.1",
    "css-color-names": "^1.0.1",
    "date-fns": "^2.30.0",
    "feather-icons": "4.29.2",
    "h2h-widget-external-links": "npm:remark-external-links@^9.0.1",
    "h2h-widget-gfm": "npm:remark-gfm@^4.0.0",
    "h2h-widget-markdown": "npm:react-markdown@^9.0.1",
    "highlight.js": "^10.7.3",
    "hono": "4.13.11",
    "html-to-text": "10.0.1",
    "i18n-iso-countries": "^6.3.0",
    "initials": "^3.1.1",
    "khroma": "^1.4.1",
    "moment": "^2.31.0",
    "moment-timezone": "^0.5.33",
    "object-merge-advanced": "^14.0.18",
    "openai": "6.46.0",
    "postal-mime": "4.0.8",
    "pretty-bytes": "^5.5.0",
    "prop-types": "^15.7.2",
    "react": "19.2.8",
    "react-bootstrap": "^2.10.6",
    "react-cool-onclickoutside": "^1.5.9",
    "react-dom": "19.2.8",
    "react-dropzone": "^14.3.5",
    "react-hook-form": "^7.45.2",
    "react-infinite-scroll-hook": "^4.0.1",
    "react-markdown": "^6.0.2",
    "react-scroll-to-bottom": "^4.0.0",
    "react-shadow": "^20.5.0",
    "react-textarea-autosize": "^8.3.2",
    "react-timeago": "^7.1.0",
    "remark-external-links": "^8.0.0",
    "remark-gfm": "^1.0.0",
    "turndown": "^7.2.0",
    "ua-parser-js": "1.0.41",
    "uqr": "0.1.2",
    "use-file-input": "^1.0.0",
    "use-window-focus": "^1.3.0",
    "uuid": "14.0.1",
    "ws": "8.21.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@runeditrun/rer": "0.2.77",
    "@tanstack/router-generator": "1.167.40",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "esbuild": "0.28.1",
    "mysql2": "3.24.6",
    "playwright": "1.63.0-alpha-2026-08-31",
    "sass": "^1.93.0",
    "typescript": "5.9.3",
    "vite": "8.2.4",
    "wrangler": "4.129.1"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.5",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "zod@<4.6.6": "4.6.6"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
