{
  "schema": 1,
  "project": {
    "schema": 1,
    "projectId": "just-every/happytohelp",
    "name": "HappyToHelp",
    "sourceRepository": "just-every/run-happytohelp",
    "license": "MIT",
    "deployment": {
      "target": "cloudflare-workers",
      "artifactFile": "happytohelp-worker-artifact.json"
    },
    "operations": {
      "setup": "node scripts/independent/setup-build.mjs",
      "build": "export PATH=\"$PWD/.rer-tools/node_modules/.bin:$PATH\" && pnpm run build",
      "verify": "export PATH=\"$PWD/.rer-tools/node_modules/.bin:$PATH\" && pnpm run verify:build",
      "artifact": "node scripts/delivery/build.mjs --clean",
      "recovery": "Retain exact source, D1 SQL and all R2 bytes; preserve applied migration identities. Follow docs/INDEPENDENT-RELEASE.md. Stop jobs before a consistent backup, restore to fresh isolated resources, reconcile uncertain provider attempts, and verify owner authority and data before switching traffic. Complete automatic RER export requires Durable Object support; do not describe a D1/R2-only backup as complete."
    }
  },
  "managed": {
    "workflowRef": "runeditrun/delivery/.github/workflows/trusted-build.yml@ff70d729948753ffdcceeca94aad063af2dcd979",
    "artifactFile": "happytohelp-worker-artifact.json",
    "buildProfile": "project",
    "verificationProfiles": [
      "full"
    ]
  },
  "artifact": {
    "specInputs": {
      "providerEffects": [
        "ai",
        "outbound-mail",
        "knowledge-crawl",
        "knowledge-vector-store",
        "support-imports",
        "github",
        "website-fetch",
        "turnstile"
      ],
      "publicVariableNames": [
