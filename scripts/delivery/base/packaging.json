      "surfaces": {
        "app": {
          "path": "/",
          "originVariable": "APP_ORIGIN",
          "signIn": {
            "path": "/login",
            "loginHint": true
          }
        },
        "websitePreview": {
          "path": "/preview/",
          "originVariable": "PREVIEW_ORIGIN",
          "readiness": [
            {
              "path": "/preview/invalid/invalid/",
              "statuses": [
                403
              ]
            }
          ]
        }
      },
      "initialSetup": {
        "path": "/api/identity/setup-status",
        "pendingStatus": 409,
        "completeStatus": 200
      },
      "recovery": "Retain source, D1 backups and R2 objects. Preserve applied migration history and reconcile uncertain provider jobs before resuming. Restore data into separate resources and verify before switching traffic.",
