{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "happytohelp-native",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "happytohelp-native",
      "database_id": "local-only-requires-setup",
      "migrations_dir": ".generated/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "happytohelp-native-files"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONVERSATIONS",
        "class_name": "ConversationSocket"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ConversationSocket"
      ]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "happytohelp-native-jobs"
      },
      {
        "binding": "JOBS_DEAD_LETTER",
        "queue": "happytohelp-native-jobs-dead"
      }
    ],
    "consumers": [
      {
        "queue": "happytohelp-native-jobs",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "happytohelp-native-jobs-dead"
      }
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "MAIL_PROVIDER": "direct",
    "MAIL_FROM": "",
    "MAIL_RELAY_URL": "",
    "H2H_RER_MAIL_VERSION": "1",
    "RER_MAILBOX_ID": "",
    "RER_MAIL_ADDRESS": "",
    "RER_MAIL_CONTROL_URL": ""
  }
}
